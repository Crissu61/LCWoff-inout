rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Doar utilizatorii autentificați (contul creat în Firebase Auth) pot citi și scrie.
    match /inbound/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.boxes is number
        && request.resource.data.boxes >= 0
        && request.resource.data.date is string;
    }
    match /outbound/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.boxes is number
        && request.resource.data.boxes >= 0
        && request.resource.data.pallets is number
        && request.resource.data.at is string;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
